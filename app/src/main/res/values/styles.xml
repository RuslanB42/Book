<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#8E8E93</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#161616</item>
        <item name="android:navigationBarColor">#161616</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#161616</item>
        <!-- no scroll bars anywhere: every list scrolls without the thin indicator at the edge -->
        <item name="android:scrollViewStyle">@style/PolkaScroll</item>
        <item name="android:horizontalScrollViewStyle">@style/PolkaHScroll</item>
        <item name="android:listViewStyle">@style/PolkaList</item>
        <!-- Soft shadows everywhere: no ambient ring round raised things (it read as a dark halo and an edge), a faint
             key-light shadow, and a wide light so its edge fades out over a long way instead of showing as a line. -->
        <item name="android:ambientShadowAlpha">0</item>
        <item name="android:spotShadowAlpha">0.08</item>
        <item name="android:lightRadius">1600dp</item>
    </style>
    <!-- Full-screen windows (the reader, the finish screen, photos) cast the same soft shadows as the app. -->
    <style name="PolkaBlack" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Soft shadows everywhere: no ambient ring round raised things (it read as a dark halo and an edge), a faint
             key-light shadow, and a wide light so its edge fades out over a long way instead of showing as a line. -->
        <item name="android:ambientShadowAlpha">0</item>
        <item name="android:spotShadowAlpha">0.08</item>
        <item name="android:lightRadius">1600dp</item>
    </style>
    <style name="PolkaBlackFull" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <!-- Soft shadows everywhere: no ambient ring round raised things (it read as a dark halo and an edge), a faint
             key-light shadow, and a wide light so its edge fades out over a long way instead of showing as a line. -->
        <item name="android:ambientShadowAlpha">0</item>
        <item name="android:spotShadowAlpha">0.08</item>
        <item name="android:lightRadius">1600dp</item>
    </style>
    <style name="PolkaScroll" parent="android:Widget.Material.ScrollView"><item name="android:scrollbars">none</item></style>
    <style name="PolkaHScroll" parent="android:Widget.Material.HorizontalScrollView"><item name="android:scrollbars">none</item></style>
    <style name="PolkaList" parent="android:Widget.Material.ListView"><item name="android:scrollbars">none</item></style>
    <style name="AppLaunchTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/launcher_background</item>
        <item name="android:navigationBarColor">@color/launcher_background</item>
    </style>
    <!-- Non-floating transparent window prevents WindowManager fitting the modal ABOVE nav bars. -->
    <style name="PolkaSheetTheme" parent="AppTheme">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
